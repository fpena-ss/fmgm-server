{
  "kind": "collectionType",
  "collectionName": "productos",
  "info": {
    "singularName": "producto",
    "pluralName": "productos",
    "displayName": "Productos",
    "description": "Productos disponibles en la tienda"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "preview": {
      "enabled": true
    }
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "blocks",
      "required": true
    },
    "precio": {
      "type": "decimal",
      "required": true
    },
    "imagenes": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "destacado": {
      "type": "boolean",
      "default": false
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "hayStock": {
      "type": "boolean",
      "default": true
    },
    "disponible": {
      "type": "boolean",
      "default": true
    }
  }
}
