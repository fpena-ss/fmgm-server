{
  "kind": "singleType",
  "collectionName": "tiendas",
  "info": {
    "singularName": "tienda",
    "pluralName": "tiendas",
    "displayName": "Tienda",
    "description": "Configuración de la tienda MGM"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "preview": {
      "enabled": true
    }
  },
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "descripcion": {
      "type": "blocks"
    },
    "whatsappNumero": {
      "type": "string",
      "required": true
    },
    "whatsappMensaje": {
      "type": "string",
      "required": false,
      "default": "Hola, estoy interesado en un producto de la tienda MGM."
    },
    "vista": {
      "type": "enumeration",
      "enum": ["grid", "compacto", "lista"],
      "default": "grid",
      "required": false
    },
    "Body": {
      "type": "dynamiczone",
      "components": [
        "sections.silder-section",
        "sections.section",
        "sections.media-slider",
        "sections.text-slider-section",
        "sections.lista-productos",
        "sections.galeria-documentos",
        "sections.formulario-embebido",
        "sections.mapa"
      ]
    }
  }
}
