{
  "kind": "collectionType",
  "collectionName": "lineas",
  "info": {
    "singularName": "linea",
    "pluralName": "lineas",
    "displayName": "Líneas de Proyectos",
    "description": "Las 5 líneas estratégicas de MGM"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "preview": {
      "enabled": true
    }
  },
  "attributes": {
    "nombre": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "nombre",
      "required": true
    },
    "descripcion": {
      "type": "blocks"
    },
    "imagen": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "orden": {
      "type": "integer",
      "default": 0
    },
    "proyectos": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::proyecto.proyecto",
      "mappedBy": "linea"
    },
    "Body": {
      "type": "dynamiczone",
      "components": [
        "sections.silder-section",
        "sections.section",
        "sections.media-slider",
        "sections.text-slider-section",
        "sections.lista-productos",
        "sections.galeria-documentos",
        "sections.formulario-embebido",
        "sections.mapa"
      ]
    }
  }
}
