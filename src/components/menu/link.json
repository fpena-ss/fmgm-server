{
  "collectionName": "components_menu_links",
  "info": {
    "displayName": "Menu Link",
    "icon": "link"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": false
    },
    "icon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "link",
      "enum": [
        "link",
        "button"
      ]
    },
    "navType": {
      "type": "enumeration",
      "required": true,
      "default": "internal",
      "enum": [
        "internal",
        "anchor",
        "external",
        "dropdown"
      ]
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "subItems": {
      "type": "component",
      "component": "menu.dropdown-item",
      "repeatable": true,
      "required": false
    }
  },
  "config": {}
}
